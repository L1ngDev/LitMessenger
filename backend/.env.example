# ===== Lit Messenger backend config =====
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env (it is gitignored).

# Port the API + file host listens on
PORT=80

# MySQL connection (runs locally on the VDS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=litmobiledb_2
DB_PASSWORD=CHANGE_ME
DB_NAME=litmobiledb

# Secret used to sign auth tokens. Generate a long random string.
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET

# Public base URL where this server is reachable (used for file links)
PUBLIC_BASE_URL=http://157.228.137.204

# Local directory where uploaded files are stored
UPLOAD_DIR=./uploads
